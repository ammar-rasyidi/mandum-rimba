# =============================================================================
# Mandum Rimba, WEB environment (Vercel "web" project)
# All vars are NEXT_PUBLIC_* (exposed to the browser). Set them in the Vercel
# project settings; locally, copy to .env.local.
# =============================================================================

# Deployed API base (the Vercel "api" project URL), no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cloudflare R2 public base serving the PMTiles (== the bucket's public/custom
# domain URL), no trailing slash.
# Optional: absolute R2 host. Leave unset to serve /tiles/* and /species/*
# same-origin (proxied via next.config rewrites — see TILES_ORIGIN there).
# NEXT_PUBLIC_TILES_BASE_URL=

# Public site origin, no trailing slash, used for canonical/OG URLs, sitemap,
# robots, and JSON-LD. Set this to the production domain in deployment.
NEXT_PUBLIC_SITE_URL=https://mandumrimba.org

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty in dev so
# local builds never report into the production property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# NASA FIRMS Map Key
# Obtain your MAP_KEY from:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
#
# Default rate limit:
# - 5,000 transactions per 10-minute interval
# - Large queries (e.g. multiple days) may consume multiple transactions
NEXT_PUBLIC_FIRMS_MAP_KEY=your_map_key_here

# CARTO basemap key for the street ("Peta") basemap.
# CARTO no longer serves these tiles anonymously: without a key they still
# return 200 with a real PNG, but the image has "API KEY REQUIRED" printed
# across it, so nothing but the map itself reveals the problem.
# Leave this empty and the map falls back to Esri's keyless Canvas basemaps —
# correct, just a different look. Set it to use CARTO.
# Free tier: 5M tile requests/month, non-commercial. Requested per domain at
# https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=